# Переменные окружения для сайта LoveFlower («ЛавФловер»)

# Токен Telegram-бота (получается у @BotFather)
# Пример: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=

# ID чата или группы менеджеров, куда отправлять заявки
# Пример личного ID: 987654321
# Пример группы: -1001987654321
TELEGRAM_CHAT_ID=

# Базовый URL сайта (для формирования кликабельных ссылок на букеты в Telegram)
BASE_URL=http://localhost:8000

# Режим отладки
DEBUG=True
